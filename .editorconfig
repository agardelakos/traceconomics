# Editor settings that match the formatters (Ruff for Python, Prettier for the site).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 120

[*.{ts,astro,mjs,js,css,json,jsonc,md}]
max_line_length = 100

# A trailing double space is a line break in Markdown.
[*.md]
trim_trailing_whitespace = false

# Saved publisher files are kept exactly as downloaded.
[tests/fixtures/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
