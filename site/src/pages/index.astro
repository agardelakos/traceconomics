---
// The root address: sends a visitor to the Greek or English site by the browser's language.
// Nothing is stored (no cookie, no local storage): the choice is made again on every visit here.
// Without scripts, the two links do the job.
import "@fontsource/source-sans-3/400.css";
import "@fontsource/source-sans-3/600.css";
import "@fontsource/source-serif-4/600.css";
import "../styles/tokens.css";
import "../styles/global.css";
---
<!doctype html>
<html lang="el">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Traceconomics</title>
    <meta name="description" content="Πληθωρισμός ανά ομάδα νοικοκυριών · Inflation by household group" />
    <link rel="alternate" hreflang="el" href="/el/" />
    <link rel="alternate" hreflang="en" href="/en/" />
  </head>
  <body>
    <main class="container stack" style="padding-top: var(--space-8); max-width: 520px">
      <h1>Traceconomics</h1>
      <p lang="el">Επιλέξτε γλώσσα</p>
      <p lang="en">Choose a language</p>
      <div class="button-row">
        <a class="button primary" href="/el/" lang="el">Ελληνικά</a>
        <a class="button" href="/en/" lang="en">English</a>
      </div>
    </main>
    <script>
      const greek = (navigator.languages ?? [navigator.language]).some((l) => l.toLowerCase().startsWith("el"));
      location.replace(greek ? "/el/" : "/en/");
    </script>
  </body>
</html>
