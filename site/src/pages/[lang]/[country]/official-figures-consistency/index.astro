---
// One country's overview: the question, a line on everything checked (consistent checks count as
// much as the rest), then every check with how often its two sides agree and where it stands, those
// with differences first, then the ways on to the questions across sources and the rules.
import Base from "../../../../layouts/Base.astro";
import { num } from "../../../../lib/format";
import { LANGS, t, type Lang } from "../../../../lib/i18n";
import { ordered as order, results, slugOf, status } from "../../../../lib/m5";
import { causes } from "../../../../lib/m5-labels";
import { countryPaths, topicHref } from "../../../../lib/topics";

export function getStaticPaths() {
  return countryPaths("official-figures-consistency", LANGS);
}

const SLUG = "official-figures-consistency";
const lang = Astro.params.lang as Lang;
const country = Astro.params.country as string;
const { checks } = results(country);
const ordered = order(checks);
const consistent = checks.length - ordered.filter((c) => c.agree < c.compared).length;
const compared = checks.reduce((n, c) => n + c.compared, 0);
const agreeing = checks.reduce((n, c) => n + c.agree, 0);
const rows = ordered.map((c) => ({
  href: topicHref(lang, SLUG, country, `checks/${slugOf(c.id, country)}`),
  title: t(lang, `m5.check.${c.id}.title`),
  source: t(lang, `m5.check.${c.id}.source`),
  count: t(lang, "m5.count", { agree: c.agree, compared: c.compared }),
  others: c.compared > c.agree ? t(lang, "m5.others", { list: causes(lang, c) }) : "",
  status: status(c),
}));
---
<Base lang={lang} title={t(lang, `topic.${SLUG}`)} description={t(lang, `topic.${SLUG}.text`)} topic={{ slug: SLUG, country, section: "" }}>
  <div class="stack-lg">
    <header class="stack" style="gap: var(--space-2); max-width: var(--text-max)">
      <h1>{t(lang, `topic.${SLUG}.question`)}</h1>
      <p style="font-size: var(--text-lg)">{t(lang, "m5.lead")}</p>
      <p data-m5="summary"><strong>{t(lang, "m5.summary", { checks: checks.length, compared: num(lang, compared, 0), agree: num(lang, agreeing, 0) })}</strong>
        {consistent > 0 && <> {t(lang, "m5.summary.consistent", { n: consistent })}</>}
        {consistent < checks.length && <> {t(lang, "m5.summary.differ", { n: checks.length - consistent })}</>}</p>
    </header>
    <div class="table-wrap">
      <table class="data-table m5-checks" data-m5="checks">
        <thead><tr><th scope="col">{t(lang, "m5.table.check")}</th><th scope="col">{t(lang, "m5.table.agree")}</th><th scope="col">{t(lang, "m5.table.status")}</th></tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <th scope="row"><a href={r.href}>{r.title}</a><span class="sub">{r.source}</span></th>
              <td><strong>{r.count}</strong>{r.others && <span class="sub">{r.others}</span>}</td>
              <td><span class={`chip-status ${r.status}`}>{t(lang, `m5.status.${r.status}`)}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="cards">
      <a class="card" href={topicHref(lang, SLUG, country, "same-question")}><span class="title">{t(lang, "nav.same-question")} →</span><span class="text">{t(lang, "m5.card.same")}</span></a>
      <a class="card" href={topicHref(lang, SLUG, country, "how-we-check")}><span class="title">{t(lang, "nav.how-we-check")} →</span><span class="text">{t(lang, "m5.card.how")}</span></a>
    </div>
  </div>
</Base>
