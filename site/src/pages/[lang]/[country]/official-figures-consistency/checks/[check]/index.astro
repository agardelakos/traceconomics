---
// One check: what it compares, how often the two sides agree and over which years (the years that
// agree count as much as the rest), each difference with its cause, the findings that have their
// own page, what is open where a cause isn't known, and the way to its files in the Data section.
import { getCollection } from "astro:content";
import SourceList from "../../../../../../components/SourceList.astro";
import Base from "../../../../../../layouts/Base.astro";
import { num } from "../../../../../../lib/format";
import { LANGS, t, type Lang } from "../../../../../../lib/i18n";
import { findings, results, slugOf, status, yearRuns } from "../../../../../../lib/m5";
import { causes, diff, periodLabel, spanLabel } from "../../../../../../lib/m5-labels";
import { countryPaths, dataHref, m5Text, topicHref } from "../../../../../../lib/topics";

const SLUG = "official-figures-consistency";
export function getStaticPaths() {
  return countryPaths("official-figures-consistency", LANGS).flatMap(({ params }) =>
    results(params.country).checks.map((c) => ({ params: { ...params, check: slugOf(c.id, params.country) } })));
}

// The table shows this many differences; every period is in the download.
const SHOWN = 60;
const lang = Astro.params.lang as Lang;
const country = Astro.params.country as string;
const c = results(country).checks.find((x) => slugOf(x.id, country) === Astro.params.check)!;
const st = status(c);
const pages = await getCollection("findings", (e) => e.id.startsWith(m5Text(country, lang, "")) && e.data.check === c.id);
const linked = findings(c).map((f) => {
  const page = pages.find((e) => e.id === m5Text(country, lang, f.slug));
  if (!page) throw new Error(`${c.id}: no ${lang} page for finding "${f.slug}"`);
  return { href: topicHref(lang, SLUG, country, `checks/${slugOf(c.id, country)}/${f.slug}`), title: page.data.title,
    summary: page.data.summary, explanation: f.explanation };
});
const shown = c.differences.slice(0, SHOWN);
const decimals = c.unit.startsWith("percent") ? 4 : 2;
// The spending table's differences name their item by ELSTAT's own (English) name, kept in the check.
const names = (c.extra?.item_names ?? {}) as Record<string, string>;
const rowLabel = (period: string) => {
  const code = period.split("/")[2];
  return code !== undefined && names[code] ? `${periodLabel(lang, period)} ${names[code]}` : periodLabel(lang, period);
};
const sources = [...new Set([c.published.reference, c.rebuilt.reference])];
const runs = yearRuns(c.by_year ?? {});
const unknown = c.differ["not-known"] ?? 0;
// Findings whose cause isn't known: their pages say what was looked at and what is still open.
const open = linked.filter((f) => f.explanation === "not-known");
const unpaged = c.differences.filter((d) => d.explanation === "not-known" && !d.finding).length;
---
<Base lang={lang} title={t(lang, `m5.check.${c.id}.title`)} description={t(lang, `m5.check.${c.id}.text`)} topic={{ slug: SLUG, country, section: "checks" }}>
  <article class="stack-lg">
    <header class="stack" style="gap: var(--space-2); max-width: var(--text-max)">
      <span class={`chip-status ${st}`}>{t(lang, `m5.status.${st}`)}</span>
      <h1>{t(lang, `m5.check.${c.id}.title`)}</h1>
      <p style="font-size: var(--text-lg)">{t(lang, `m5.check.${c.id}.text`)}</p>
      <p data-m5="count"><strong>{t(lang, "m5.count", { agree: c.agree, compared: c.compared })}</strong>{c.first && ` (${spanLabel(lang, c.first)} – ${spanLabel(lang, c.last!)})`}{c.compared > c.agree && <>. {t(lang, "m5.others", { list: causes(lang, c) })}</>}</p>
    </header>
    {linked.length > 0 && (
      <section class="stack" style="gap: var(--space-3)" aria-labelledby="findings-h">
        <h2 id="findings-h">{t(lang, "m5.finding.read")}</h2>
        <div class="cards">{linked.map((f) => <a class="card" href={f.href}><span class="title">{f.title} →</span><span class="text">{f.summary}</span></a>)}</div>
      </section>
    )}
    {runs.length > 0 && (
      <section class="stack" style="gap: var(--space-3)" aria-labelledby="compared-h">
        <h2 id="compared-h">{t(lang, "m5.compared.title")}</h2>
        <div class="table-wrap">
          <table class="data-table" data-m5="compared">
            <thead><tr><th scope="col">{t(lang, "m5.compared.years")}</th><th scope="col">{t(lang, "m5.compared.count")}</th><th scope="col">{t(lang, "m5.compared.agree")}</th></tr></thead>
            <tbody>{runs.map((r) => (
              <tr class={r.agree === r.compared ? "" : "differs"}><th scope="row">{r.from === r.to ? r.from : `${r.from}–${r.to}`}</th>
                <td>{num(lang, r.compared, 0)}</td><td>{r.agree === r.compared ? t(lang, "m5.compared.all") : num(lang, r.agree, 0)}</td></tr>
            ))}</tbody>
          </table>
        </div>
      </section>
    )}
    <section class="stack" style="gap: var(--space-3)" aria-labelledby="diff-h">
      <h2 id="diff-h">{t(lang, "m5.diff.title")}</h2>
      {c.differences.length === 0 ? <p>{t(lang, "m5.diff.none")}</p> : (
        <div class="table-wrap">
          <table class="data-table" data-m5="differences">
            <thead><tr>
              <th scope="col">{t(lang, "m5.diff.period")}</th><th scope="col">{t(lang, "m5.diff.published")}</th>
              <th scope="col">{t(lang, "m5.diff.rebuilt")}</th><th scope="col">{t(lang, "m5.diff.difference")}</th><th scope="col">{t(lang, "m5.diff.why")}</th>
            </tr></thead>
            <tbody>{shown.map((d) => (
              <tr><th scope="row">{rowLabel(d.period)}</th><td>{num(lang, d.published, decimals)}</td><td>{num(lang, d.rebuilt, decimals)}</td>
                <td>{diff(lang, d.difference)}</td><td>{t(lang, `m5.cat.${d.explanation}`)}</td></tr>
            ))}</tbody>
          </table>
        </div>
      )}
      {c.differences.length > SHOWN && <p>{t(lang, "m5.diff.more", { shown: SHOWN, total: c.differences.length })}</p>}
    </section>
    {unknown > 0 && (
      <section class="stack" style="gap: var(--space-2); max-width: var(--text-max)" aria-labelledby="open-h" data-m5="open">
        <h2 id="open-h">{t(lang, "m5.open.title")}</h2>
        <p>{t(lang, "m5.open.count", { n: unknown })}</p>
        {open.map((f) => <p>{t(lang, "m5.open.finding")} <a href={f.href}>{f.title}</a>.</p>)}
        {unpaged > 0 && <p>{t(lang, "m5.open.unpaged", { n: unpaged })}</p>}
        <p>{t(lang, "m5.open.ideas")} <a href="mailto:support@traceconomics.com">support@traceconomics.com</a>.</p>
      </section>
    )}
    <p data-m5="files"><a href={`${dataHref(lang, country)}#${SLUG}`}>{t(lang, "m5.files")} →</a></p>
    <details class="panel">
      <summary>{t(lang, "m5.finding.sources")}</summary>
      <div style="margin-top: var(--space-3)"><SourceList keys={sources} lang={lang} /></div>
    </details>
  </article>
</Base>
