---
// One finding: the written account of a difference (src/content/findings/<lang>/<slug>.md), with
// the numbers from the check it belongs to and its sources.
import { getCollection, render } from "astro:content";
import SourceList from "../../../../../../components/SourceList.astro";
import Base from "../../../../../../layouts/Base.astro";
import { LANGS, t, type Lang } from "../../../../../../lib/i18n";
import { findings, results, slugOf } from "../../../../../../lib/m5";
import { checkStrip } from "../../../../../../lib/m5-strip";
import { countryPaths, topicHref } from "../../../../../../lib/topics";

const SLUG = "official-figures-consistency";
export function getStaticPaths() {
  return countryPaths("official-figures-consistency", LANGS).flatMap(({ params }) =>
    results(params.country).checks.flatMap((c) => findings(c).map((f) => (
      { params: { ...params, check: slugOf(c.id, params.country), finding: f.slug } }))));
}

const lang = Astro.params.lang as Lang;
const country = Astro.params.country as string;
const c = results(country).checks.find((x) => slugOf(x.id, country) === Astro.params.check)!;
const entry = (await getCollection("findings", (e) => e.id === `${lang}/${Astro.params.finding}`))[0];
if (!entry || entry.data.check !== c.id) throw new Error(`no ${lang} finding "${Astro.params.finding}" for ${c.id}`);
const { Content } = await render(entry);
const st = findings(c).find((f) => f.slug === Astro.params.finding)!.explanation === "not-known" ? "unknown" : "explained";
---
<Base lang={lang} title={entry.data.title} description={entry.data.summary} topic={{ slug: SLUG, country, section: `checks/${Astro.params.check}/${Astro.params.finding}` }}
  strip={checkStrip(lang, country, c.id)}>
  <article class="stack-lg">
    <header class="stack" style="gap: var(--space-2); max-width: var(--text-max)">
      <p><a href={topicHref(lang, SLUG, country, `checks/${Astro.params.check}`)}>{t(lang, `m5.check.${c.id}.title`)}</a></p>
      <span class={`chip-status ${st}`}>{t(lang, `m5.status.${st}`)}</span>
      <h1>{entry.data.title}</h1>
      <p style="font-size: var(--text-lg)">{entry.data.summary}</p>
    </header>
    <section class="prose"><Content /></section>
    <details class="panel">
      <summary>{t(lang, "m5.finding.sources")}</summary>
      <div style="margin-top: var(--space-3)"><SourceList keys={entry.data.sources} lang={lang} /></div>
    </details>
  </article>
</Base>
