---
// Every check, each with what it compares and how: the way into each check's own page.
import Base from "../../../../../layouts/Base.astro";
import { LANGS, t, type Lang } from "../../../../../lib/i18n";
import { ordered, results, slugOf, status } from "../../../../../lib/m5";
import { countryPaths, topicHref } from "../../../../../lib/topics";

export function getStaticPaths() {
  return countryPaths("official-figures-consistency", LANGS);
}

const SLUG = "official-figures-consistency";
const lang = Astro.params.lang as Lang;
const country = Astro.params.country as string;
const { checks } = results(country);
---
<Base lang={lang} title={t(lang, "nav.checks")} description={t(lang, "m5.lead")} topic={{ slug: SLUG, country, section: "checks" }}>
  <div class="stack-lg">
    <h1>{t(lang, "nav.checks")}</h1>
    <ul class="stack" style="list-style: none; padding: 0; gap: var(--space-3)" data-m5="check-list">
      {ordered(checks).map((c) => (
        <li class="panel stack" style="gap: var(--space-2)">
          <span class={`chip-status ${status(c)}`}>{t(lang, `m5.status.${status(c)}`)}</span>
          <h2 style="margin: 0"><a href={topicHref(lang, SLUG, country, `checks/${slugOf(c.id, country)}`)}>{t(lang, `m5.check.${c.id}.title`)}</a></h2>
          <p style="margin: 0">{t(lang, `m5.check.${c.id}.text`)}</p>
          <p style="margin: 0"><strong>{t(lang, "m5.count", { agree: c.agree, compared: c.compared })}</strong> · {t(lang, `m5.check.${c.id}.source`)}</p>
        </li>
      ))}
    </ul>
  </div>
</Base>
