---
// Every check as a card, explained first, with buttons to show one status at a time
// (M5CheckCards). Each card leads to the check's own page.
import M5CheckCards from "../../../../../components/M5CheckCards.astro";
import Base from "../../../../../layouts/Base.astro";
import { LANGS, t, type Lang } from "../../../../../lib/i18n";
import { countryPaths } from "../../../../../lib/topics";

export function getStaticPaths() {
  return countryPaths("official-figures-consistency", LANGS);
}

const SLUG = "official-figures-consistency";
const lang = Astro.params.lang as Lang;
const country = Astro.params.country as string;
---

<Base
  lang={lang}
  title={t(lang, "nav.checks")}
  description={t(lang, "m5.checks.lead")}
  topic={{ slug: SLUG, country, section: "checks" }}
>
  <div class="stack-lg">
    <header class="stack" style="gap: var(--space-2); max-width: var(--text-max)">
      <h1>{t(lang, "nav.checks")}</h1>
      <p style="font-size: var(--text-lg)">{t(lang, "m5.checks.lead")}</p>
    </header>
    <M5CheckCards lang={lang} country={country} />
  </div>
</Base>
