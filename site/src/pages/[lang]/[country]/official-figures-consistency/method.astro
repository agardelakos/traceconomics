---
// The rules every check follows, in plain words (src/content/pages/<lang>/m5-method.md).
import { getEntry, render } from "astro:content";
import SourceList from "../../../../components/SourceList.astro";
import Base from "../../../../layouts/Base.astro";
import { LANGS, t, type Lang } from "../../../../lib/i18n";
import { countryPaths, m5Text } from "../../../../lib/topics";

export function getStaticPaths() {
  return countryPaths("official-figures-consistency", LANGS);
}

const lang = Astro.params.lang as Lang;
const country = Astro.params.country as string;
const entry = await getEntry("pages", m5Text(country, lang, "m5-method"));
if (!entry) throw new Error(`no ${lang} page m5-method`);
const { Content } = await render(entry);
---

<Base
  lang={lang}
  title={entry.data.title}
  description={entry.data.summary}
  topic={{ slug: "official-figures-consistency", country, section: "method" }}
>
  <article class="stack-lg">
    <header class="stack gap-2 measure">
      <h1>{entry.data.title}</h1>
      <p class="text-lg">{entry.data.summary}</p>
    </header>
    <section class="prose">
      <Content />
    </section>
    <details class="panel">
      <summary>{t(lang, "m5.finding.sources")}</summary>
      <div class="mt-3">
        <SourceList keys={entry.data.sources} lang={lang} />
      </div>
    </details>
  </article>
</Base>
