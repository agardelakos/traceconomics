---
// The method for one country in plain language, with links to each option's page and the sources.
import { getCollection, render } from "astro:content";
import SourceList from "../../../../../components/SourceList.astro";
import Base from "../../../../../layouts/Base.astro";
import CardNav from "../../../../../components/ui/CardNav.astro";
import { LANGS, t, type Lang } from "../../../../../lib/i18n";
import { countryPaths, m1Text, topicHref } from "../../../../../lib/topics";

export function getStaticPaths() {
  return countryPaths("inflation-by-group", LANGS);
}

const lang = Astro.params.lang as Lang;
const country = Astro.params.country as string;
const pages = (
  await getCollection("method", (e) => e.id.startsWith(m1Text(country, lang, "")))
).sort((a, b) => a.data.order - b.data.order);
const main = pages.find((e) => e.id === `${lang}/overview`);
if (!main) throw new Error(`no method page for ${lang}`);
const options = pages.filter((e) => e.data.option);
const { Content } = await render(main);
---

<Base
  lang={lang}
  title={main.data.title}
  description={main.data.summary}
  topic={{ slug: "inflation-by-group", country, section: "method" }}
>
  <article class="stack-lg">
    <header class="stack gap-2 measure">
      <h1>{main.data.title}</h1>
      <p class="text-lg">{main.data.summary}</p>
    </header>
    <CardNav id="options-h" title={t(lang, "method.options")}>
      <div class="cards">
        {options.map((e) => (
          <a
            class="card"
            href={topicHref(lang, "inflation-by-group", country, `method/${e.id.split("/")[1]}`)}
          >
            <span class="title">{e.data.title} →</span>
            <span class="text">{e.data.summary}</span>
          </a>
        ))}
      </div>
    </CardNav>
    <section class="prose">
      <Content />
    </section>
    <details class="panel">
      <summary>{t(lang, "method.sources")}</summary>
      <div class="mt-3">
        <SourceList keys={main.data.sources} lang={lang} />
      </div>
    </details>
  </article>
</Base>
