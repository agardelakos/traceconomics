---
// Explore: every group, every option, in the order a first-time visitor needs them: how to use the
// page, then one card with the chart's two views (over time, and what made up the latest rate) and
// the controls that drive both, then what doesn't change the chart (files, citing, sources). The page carries all its controls and the default view's text; a script
// loads the chosen setting's file and redraws. The chosen groups and options live
// in the address, so a shared link opens the same view.
import GlossaryTerm from "../../../../components/GlossaryTerm.astro";
import OptionTerm from "../../../../components/OptionTerm.astro";
import SourceList from "../../../../components/SourceList.astro";
import Base from "../../../../layouts/Base.astro";
import { availability, labels, m1Dir, settings } from "../../../../lib/data";
import { LANGS, LOCALE, t, type Lang } from "../../../../lib/i18n";
import { countryPaths, dataHref, topicHref } from "../../../../lib/topics";
import el from "../../../../i18n/el.json";
import en from "../../../../i18n/en.json";

export function getStaticPaths() {
  return countryPaths("inflation-by-group", LANGS);
}

const lang = Astro.params.lang as Lang;
const country = Astro.params.country as string;
const set = settings(country);
const avail = availability(country);
const names = labels().labels;
const divisions = Object.fromEntries(Object.entries(names).filter(([c]) => c.length === 2).map(([c, l]) => [c, l[lang]]));

const OPTIONS = ["grouping", "spending", "imputed_rent", "price_source", "weights_timing", "tutoring"] as const;
const values: Record<string, string[]> = { grouping: ["B", "A", "C"], ...set.options };
const defaults: Record<string, string> = { grouping: "B", ...Object.fromEntries(Object.entries(set.settings.find((s) => s.default)!).filter(([k]) => k in set.options)) };
const fixedGreyed: Record<string, { value: string; reason: string }[]> = {
  imputed_rent: [{ value: "user_cost", reason: "reason.user_cost" }],
};
const FAMILIES = [
  { key: "income", groups: ["Q1", "Q2", "Q3", "Q4", "Q5"] },
  { key: "tenure", groups: ["tenure/renter", "tenure/owner", "tenure/rent_free"] },
  { key: "other", groups: ["all/all", "pensioners/pensioners", "pensioners/other"] },
];
const COLORS: Record<string, string> = {
  Q1: "var(--series-q1)", Q2: "var(--series-q2)", Q3: "var(--series-q3)", Q4: "var(--series-q4)", Q5: "var(--series-q5)",
  "all/all": "var(--series-all)", "tenure/renter": "var(--series-renter)", "tenure/owner": "var(--series-owner)",
  "tenure/rent_free": "var(--series-rent-free)", "pensioners/pensioners": "var(--series-pensioners)", "pensioners/other": "var(--series-other)",
};
const dashOf = (g: string) => (g.startsWith("tenure/") ? "6 4" : g.startsWith("pensioners/") ? "1.5 3.5" : "");

const config = {
  lang, locale: LOCALE[lang], base: `/data/v1/${m1Dir(country)}`, defaultSlug: set.default,
  optionKeys: OPTIONS, values, defaults, colors: COLORS,
  dash: Object.fromEntries(FAMILIES.flatMap((f) => f.groups).map((g) => [g, dashOf(g)])),
  availability: avail.options, divisions, dataPage: dataHref(lang, country), country: t(lang, `country.${country}`),
  strings: lang === "el" ? el : en,
};

const SOURCES = ["elstat-cpi-items", "elstat-hbs-puf", "eurostat-prc-hicp-minr", "hicp-manual-2024", "cpi-manual-2020", "eurostat-equivalence-scale"];
---
<Base lang={lang} title={t(lang, "explore.title")} description={t(lang, "explore.lead", { country: t(lang, `country.${country}`) })} topic={{ slug: "inflation-by-group", country, section: "explore" }}>
  <div class="stack-lg" id="explore" data-config={JSON.stringify(config)}>
    <div class="stack" style="gap: var(--space-2)">
      <h1>{t(lang, "explore.title")}</h1>
      <p class="muted" style="max-width: var(--text-max)">{t(lang, "explore.lead", { country: t(lang, `country.${country}`) })}</p>
    </div>

    <section class="howto" aria-labelledby="howto-h">
      <h2 id="howto-h" class="eyebrow accent">{t(lang, "explore.how.title")}</h2>
      <ol>
        <li><span class="n" aria-hidden="true">1</span><span>{t(lang, "explore.how.1")}</span></li>
        <li><span class="n" aria-hidden="true">2</span><span>{t(lang, "explore.how.2")}</span></li>
        <li><span class="n" aria-hidden="true">3</span><span>{t(lang, "explore.how.3")}</span></li>
      </ol>
      <p class="small"><a href={topicHref(lang, "inflation-by-group")}>{t(lang, "explore.how.new")} →</a></p>
    </section>

    <section class="panel chart-block" aria-label={t(lang, "explore.chart_title")}>
      <figure class="chart" data-role="chart-figure">
        <figcaption class="stack" style="gap: var(--space-1)">
          <div class="chart-head">
            <h2>{t(lang, "explore.chart_title")}</h2>
            <button type="button" class="icon-button" data-role="fullscreen" hidden aria-label={t(lang, "chart.fullscreen")} title={t(lang, "chart.fullscreen")}>
              <svg class="fs-enter" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 7V2h5M11 2h5v5M16 11v5h-5M7 16H2v-5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              <svg class="fs-exit" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M7 2v5H2M16 7h-5V2M11 16v-5h5M2 11h5v5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </button>
          </div>
          <div class="view-switch" role="group" aria-label={t(lang, "explore.view.label")}>
            <button type="button" data-view="time" aria-pressed="true">{t(lang, "explore.view.time")}</button>
            <button type="button" data-view="parts" aria-pressed="false">{t(lang, "explore.view.parts")}</button>
          </div>
          <p data-role="summary" aria-live="polite"></p>
          <p data-role="contrib-title" aria-live="polite" hidden></p>
        </figcaption>
        <div class="callout caution" data-role="notice" hidden>
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.5 L15 14 H1 Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path><path d="M8 6v4M8 12v.1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
          <span></span>
        </div>
        <div data-role="loading" class="stack" aria-busy="true">
          <div class="skeleton" style="height: 240px"></div>
          <span class="small muted">{t(lang, "chart.loading")}</span>
        </div>
        <div data-role="failed" role="alert" class="stack" hidden>
          <strong>{t(lang, "chart.failed")}</strong>
          <span class="muted">{t(lang, "chart.failed_hint")}</span>
          <button type="button" class="button" data-role="retry" style="align-self: flex-start">{t(lang, "chart.retry")}</button>
        </div>
        <div class="stack view-pane" data-role="view-time" style="gap: var(--space-3)">
        <div class="chart-area" role="img" data-role="chart"></div>
        <p class="small" style="font-weight: 600" data-role="gap-title" hidden>{t(lang, "gap.long")}</p>
        <p class="small muted" data-role="gap-note" hidden>{t(lang, "explore.gap_not_drawn")}</p>
        <div class="chart-gap" hidden></div>
        <div class="legend" data-role="legend"></div>
        <details class="fold" data-role="table-fold">
          <summary><h3>{t(lang, "chart.data_points")}</h3></summary>
          <div class="table-wrap" data-role="table" tabindex="0" role="region" aria-label={t(lang, "chart.data_points")} style="max-height: 420px; overflow-y: auto; margin-top: var(--space-3)"></div>
        </details>
        <ol class="footnotes" data-role="footnotes"></ol>
        </div>
        <div class="stack view-pane" data-role="view-parts" style="gap: var(--space-3)" hidden>
          <p class="muted" data-role="contrib-none" hidden>{t(lang, "explore.contrib_none")}</p>
          <div class="stack" data-role="contrib" style="gap: var(--space-3)">
            <p class="small muted" data-role="contrib-note"></p>
            <div class="bars" data-role="bars"></div>
            <button type="button" class="button quiet" data-role="contrib-more" hidden style="align-self: flex-start"></button>
          </div>
        </div>
      </figure>
      <div class="chart-controls">
        <h2 class="eyebrow accent">{t(lang, "explore.controls")}</h2>
        <label class="stack" style="gap: 6px; font-weight: 600; max-width: 320px">{t(lang, "explore.measure")}
          <select data-role="measure">
            {["rch_a", "rch_m", "index"].map((m) => <option value={m}>{t(lang, `explore.measure.${m}`)}</option>)}
          </select>
        </label>
        <p class="small muted" data-role="measure-reason" hidden style="margin-top: calc(-1 * var(--space-2))">{t(lang, "explore.measure_parts")}</p>
        <div class="stack" style="gap: 2px">
          <label class="check"><input type="checkbox" data-role="gap-toggle" checked /> <span>{t(lang, "explore.gap_toggle")}</span></label>
          <p class="small muted" data-role="gap-reason" hidden>{t(lang, "explore.gap_annual_only")}</p>
        </div>
      <details class="fold" open>
        <summary><h3>{t(lang, "explore.groups")}</h3> <span class="small muted" style="font-weight: 400" data-role="group-count"></span></summary>
        <div class="stack" style="gap: var(--space-3); margin-top: var(--space-3)">
        {FAMILIES.map((f) => (
          <div class="stack" style="gap: 6px">
            <div class="family-head">
            <span class="small muted" style="font-weight: 600">{f.key === "income" ? <GlossaryTerm lang={lang} term="quintile" label={t(lang, "family.income")} /> : f.key === "tenure" ? <GlossaryTerm lang={lang} term="tenure" label={t(lang, "family.tenure")} /> : t(lang, `family.${f.key}`)}</span>
            {f.key === "income" && <a class="small" href={`${topicHref(lang, "inflation-by-group", country, "groups")}#income`}>{t(lang, "income.title")}</a>}
            </div>
            <div class="chips">
              {f.groups.map((g) => (
                <button type="button" class="chip" data-group={g} aria-pressed="false">
                  <svg width="20" height="10" viewBox="0 0 20 10" aria-hidden="true"><line x1="1" y1="5" x2="19" y2="5" stroke={COLORS[g]} stroke-width="2.5" stroke-dasharray={dashOf(g) || undefined} stroke-linecap="round"></line></svg>
                  <span>{t(lang, g.startsWith("Q") ? `group.${g}` : `group.${g}`)}</span>
                </button>
              ))}
            </div>
          </div>
        ))}
        <p class="small muted" style="font-weight: 600">{t(lang, "family.household")} <span class="planned-tag">{t(lang, "soon")}</span></p>
        </div>
      </details>

      <details class="fold">
        <summary><h3>{t(lang, "option.heading")}</h3> <span class="small muted" style="font-weight: 400" data-role="changed"></span></summary>
        <div class="options" style="margin-top: var(--space-4)">
          {OPTIONS.map((o) => (
            <fieldset class="option" data-option={o}>
              <legend><OptionTerm lang={lang} country={country} option={o} label={t(lang, `option.${o}`)} /></legend>
              <div class="values">
                {values[o].map((v) => (
                  <label>
                    <input type="radio" name={o} value={v} checked={v === defaults[o]} />
                    <span>{t(lang, `option.${o}.${v}`)}</span>
                    {v === defaults[o] && <span class="badge-default">{t(lang, "option.default")}</span>}
                  </label>
                ))}
                {(fixedGreyed[o] ?? []).map((g) => (
                  <label>
                    <input type="radio" name={o} value={g.value} disabled />
                    <span>{t(lang, `option.${o}.${g.value}`)}</span>
                  </label>
                ))}
              </div>
              {(fixedGreyed[o] ?? []).map((g) => (
                <p class="note"><span>{t(lang, `option.${o}.${g.value}`)} — {t(lang, "option.unavailable", { reason: t(lang, g.reason) })}</span></p>
              ))}
              <div class="note" data-role="note"></div>
            </fieldset>
          ))}
          <fieldset class="option">
            <legend>{t(lang, "option.hh_weighting.democratic")}</legend>
            <p class="note"><span class="planned-tag">{t(lang, "soon")}</span></p>
          </fieldset>
          <fieldset class="option">
            <legend>{t(lang, "option.income_support.shown")}</legend>
            <p class="note"><span class="planned-tag">{t(lang, "soon")}</span></p>
          </fieldset>
        </div>
      </details>

      </div>
    </section>


    <section class="stack more-block" aria-labelledby="more-h">
      <h2 id="more-h">{t(lang, "explore.more")}</h2>
      <details class="panel">
        <summary>{t(lang, "explore.downloads")}</summary>
        <div class="stack" style="gap: var(--space-2); margin-top: var(--space-3)">
          <p class="small muted" style="max-width: var(--text-max)">{t(lang, "explore.files.text", { country: t(lang, `country.${country}`) })}</p>
          <div class="button-row">
            <a class="button primary" href={`${dataHref(lang, country)}#setting-${set.default}`} data-role="files-this">{t(lang, "explore.files.this")} →</a>
            <a class="button" href={dataHref(lang, country)}>{t(lang, "opendata.all")}</a>
          </div>
        </div>
      </details>
      <details class="panel">
        <summary>{t(lang, "explore.cite")}</summary>
        <p class="small" style="margin-top: var(--space-3)" data-role="cite"></p>
      </details>
      <details class="panel">
        <summary>{t(lang, "explore.sources")}</summary>
        <div style="margin-top: var(--space-3)"><SourceList keys={SOURCES} lang={lang} /></div>
      </details>
    </section>
  </div>
</Base>

<script>
  import { start } from "../../../../scripts/explore";
  const root = document.getElementById("explore");
  if (root) start(root);
</script>
