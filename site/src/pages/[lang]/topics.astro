---
// Every topic, as the home page shows them: the live ones lead to their page across countries;
// the header's Topics label leads here.
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/ui/Breadcrumb.astro";
import { LANGS, t, type Lang } from "../../lib/i18n";
import TopicCards from "../../components/TopicCards.astro";
import { topicHref } from "../../lib/topics";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<Base
  lang={lang}
  title={t(lang, "nav.topics")}
  description={t(lang, "topics.lead")}
  path="topics"
  current="topics"
>
  <article class="stack-lg">
    <header class="stack gap-2 measure">
      <Breadcrumb lang={lang} trail={[[t(lang, "nav.topics")]]} />
      <h1>{t(lang, "nav.topics")}</h1>
      <p class="text-lg">{t(lang, "topics.lead")}</p>
    </header>
    <section class="stack gap-3">
      <TopicCards
        lang={lang}
        link={(tp) => (tp.status === "live" ? topicHref(lang, tp.slug) : null)}
      />
    </section>
  </article>
</Base>
