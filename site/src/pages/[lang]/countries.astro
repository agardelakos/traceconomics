---
// Every country, as the home page shows them; the header's Countries label leads here.
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/ui/Breadcrumb.astro";
import { LANGS, t, type Lang } from "../../lib/i18n";
import CountryCards from "../../components/CountryCards.astro";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<Base
  lang={lang}
  title={t(lang, "nav.countries")}
  description={t(lang, "countries.lead")}
  path="countries"
  current="countries"
>
  <article class="stack-lg">
    <header class="stack gap-2 measure">
      <Breadcrumb lang={lang} trail={[[t(lang, "nav.countries")]]} />
      <h1>{t(lang, "nav.countries")}</h1>
      <p class="text-lg">{t(lang, "countries.lead")}</p>
    </header>
    <section class="stack gap-3">
      <CountryCards lang={lang} />
    </section>
  </article>
</Base>
