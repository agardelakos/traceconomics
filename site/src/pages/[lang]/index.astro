---
// Home: the latest numbers for the poorest and richest fifth, the long chart, and where to go next.
// Every number comes from the default series file at build time.
import GlossaryTerm from "../../components/GlossaryTerm.astro";
import Base from "../../layouts/Base.astro";
import { calculator, latest, months, series, settings } from "../../lib/data";
import { href, LANGS, LOCALE, month, num, pct, t, type Lang } from "../../lib/i18n";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const slug = settings().default;
const s = series(slug);
const axis = months(s);
const q1 = latest(s.groups["B/Q1"].rch_a, axis)!;
const q5 = latest(s.groups["B/Q5"].rch_a, axis)!;
const all = latest(s.groups["all/all"].rch_a, axis)!;
const gap = latest(s.gaps["B"].rch_a, axis)!;
const gaps = s.gaps["B"].rch_a;
const peakI = gaps.reduce((best: number, v, i) => (v !== null && v > (gaps[best] ?? -Infinity) ? i : best), 0);
const peak = { period: axis[peakI], value: gaps[peakI] as number };
const peakYear = peak.period.slice(0, 4);
const avgQ1 = s.groups["B/Q1"].avg[peakYear];
const avgQ5 = s.groups["B/Q5"].avg[peakYear];

// Food's share of spending (division 01) in the newest year's weights, from the calculator file.
const calc = calculator();
const foodShare = (preset: string) => {
  const years = Object.keys(calc.presets[preset]).sort();
  const rows: [number, number][] = calc.presets[preset][years[years.length - 1]];
  const total = rows.reduce((a, [, w]) => a + w, 0);
  const food = rows.filter(([i]) => calc.codes[i].startsWith("01")).reduce((a, [, w]) => a + w, 0);
  return Math.round((food / total) * 100);
};

const acc = (p: string) => month(lang, p, "acc");
const tiles = [
  { label: t(lang, "group.Q1"), value: num(lang, q1.value), unit: "%", note: t(lang, "home.tile.note", { month: month(lang, q1.period) }), color: "var(--series-q1)" },
  { label: t(lang, "group.Q5"), value: num(lang, q5.value), unit: "%", note: t(lang, "home.tile.note", { month: month(lang, q5.period) }), color: "var(--series-q5)" },
  { label: t(lang, "group.all/all"), value: num(lang, all.value), unit: "%", note: t(lang, "home.tile.note", { month: month(lang, all.period) }), color: "var(--series-all)" },
  { label: t(lang, "gap"), term: "gap", value: num(lang, gap.value), unit: ` ${t(lang, "unit.points_short")}`, note: t(lang, "home.tile.gap_note", { peak: num(lang, peak.value), peakMonth: acc(peak.period) }), color: null },
];

const flag = s.flags[0];
const spec = {
  src: `/data/v1/gr/m1/latest/series/${slug}.json`,
  locale: LOCALE[lang],
  lines: [
    { key: "B/Q1", label: t(lang, "group.short.Q1"), color: "var(--series-q1)" },
    { key: "B/Q5", label: t(lang, "group.short.Q5"), color: "var(--series-q5)" },
  ],
  gap: { group: "B", title: t(lang, "gap") },
  flag: { to: flag.rch_a_to, fill: "var(--chart-flag-fill)" },
  from: "2010-01",
};
const tableRows = axis.map((p, i) => ({ p, a: s.groups["B/Q1"].rch_a[i], b: s.groups["B/Q5"].rch_a[i], g: gaps[i] }))
  .filter((r) => r.a !== null && r.b !== null && r.p >= "2010-01").reverse();
const summary = t(lang, "summary.annual", {
  month: lang === "el" ? acc(q1.period) : month(lang, q1.period),
  list: [t(lang, "summary.item", { value: pct(lang, q1.value), group: t(lang, "group.in.Q1") }),
         t(lang, "summary.item", { value: pct(lang, q5.value), group: t(lang, "group.in.Q5") })].join(` ${t(lang, "summary.and")} `),
});
---
<Base lang={lang} title={t(lang, "home.title")} description={t(lang, "site.tagline")} current="home">
  <div class="stack-lg">
    <section class="stack" style="gap: var(--space-3)">
      <p class="eyebrow">{t(lang, "home.eyebrow", { country: t(lang, "country.gr"), month: month(lang, q1.period) })}</p>
      <h1>{t(lang, "home.title")}</h1>
      <p style="font-size: var(--text-lg); max-width: var(--text-max)">
        {t(lang, "home.lead", {
          month: lang === "el" ? acc(q1.period) : month(lang, q1.period),
          q1: pct(lang, q1.value), q5: pct(lang, q5.value), gap: num(lang, gap.value),
          peakYear, peak: num(lang, peak.value),
        })}
      </p>
    </section>

    <section class="tiles" aria-label={t(lang, "nav.home")}>
      {tiles.map((tile) => (
        <div class="tile">
          <span class="label">
            {tile.color && (
              <svg class="swatch-line" width="16" height="8" viewBox="0 0 16 8" aria-hidden="true">
                <line x1="1" y1="4" x2="15" y2="4" stroke={tile.color} stroke-width="2.5" stroke-linecap="round"></line>
              </svg>
            )}
            {tile.term ? <GlossaryTerm lang={lang} term={tile.term} label={tile.label} /> : tile.label}
          </span>
          <span class="value">{tile.value}<span class="unit">{tile.unit}</span></span>
          <span class="note">{tile.note}</span>
        </div>
      ))}
    </section>

    <figure class="chart panel" data-chart={JSON.stringify(spec)}>
      <figcaption class="stack" style="gap: var(--space-1)">
        <h2>{t(lang, "home.chart.title")}</h2>
        <p class="muted">{summary} {t(lang, "home.chart.note", { year: peakYear, q1: pct(lang, avgQ1), q5: pct(lang, avgQ5) })}</p>
      </figcaption>
      <div class="chart-area" role="img" aria-label={summary}></div>
      <p class="small" style="font-weight: 600">{t(lang, "gap.long")}</p>
      <div class="chart-gap" hidden></div>
      <div class="legend">
        <span class="key"><span class="box" style="background: var(--chart-flag-fill)"></span>{t(lang, `flag.legend.${flag.code}`)}¹</span>
        <span class="key"><span class="box" style="background: var(--color-text); opacity: 0.12"></span>{t(lang, "chart.band")}</span>
        <span class="key"><span class="box" style="background: var(--color-disabled)"></span>{t(lang, "chart.noband")}</span>
      </div>
      <details>
        <summary class="button">{t(lang, "chart.show_table")}</summary>
        <div class="table-wrap" style="margin-top: var(--space-3); max-height: 420px; overflow-y: auto">
          <table class="data-table">
            <thead><tr><th scope="col">{t(lang, "chart.month")}</th><th scope="col">{t(lang, "group.Q1")}</th><th scope="col">{t(lang, "group.Q5")}</th><th scope="col">{t(lang, "gap")}</th></tr></thead>
            <tbody>
              {tableRows.map((r) => (
                <tr><th scope="row">{r.p}</th><td>{num(lang, r.a!)}</td><td>{num(lang, r.b!)}</td><td>{r.g === null ? "–" : num(lang, r.g)}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
      <ol class="footnotes">
        <li>{t(lang, `reason.${flag.code.replace(" ", "_")}`)}</li>
        <li>{t(lang, "reason.hospital", { first: 2008, last: 2014 })}</li>
      </ol>
      <div class="button-row">
        <a class="button primary" href={href(lang, "explore")}>{t(lang, "home.card.explore")} →</a>
      </div>
    </figure>

    <section class="callout">
      <svg width="20" height="20" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M8 7v4.5M8 4.6v.1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
      <div class="stack" style="gap: var(--space-1)">
        <h2 style="font-family: var(--font-sans); font-size: var(--text-base); font-weight: 700">{t(lang, "home.why.title")}</h2>
        <p>{t(lang, "home.why.text", { q1food: `${foodShare("B/Q1")}%`, q5food: `${foodShare("B/Q5")}%` })}</p>
      </div>
    </section>

    <nav class="cards" aria-label={t(lang, "nav.next")}>
      {(["explore", "calculator", "method"] as const).map((k) => (
        <a class="card" href={href(lang, k)}>
          <span class="title">{t(lang, `home.card.${k}`)} →</span>
          <span class="text">{t(lang, `home.card.${k}.text`)}</span>
        </a>
      ))}
    </nav>

    <section class="stack" style="gap: var(--space-2); border-top: 1px solid var(--color-border); padding-top: var(--space-5)">
      <h2 style="font-family: var(--font-sans); font-size: var(--text-base); font-weight: 700">{t(lang, "home.open.title")}</h2>
      <p class="muted" style="max-width: var(--text-max)">{t(lang, "home.open.text")}</p>
      <a href={href(lang, "data")} style="font-weight: 600">{t(lang, "home.data_link")}</a>
    </section>
  </div>
</Base>

<script>
  import { mountFigure } from "../../scripts/figure";
  for (const fig of document.querySelectorAll<HTMLElement>("figure[data-chart]")) mountFigure(fig);
</script>
