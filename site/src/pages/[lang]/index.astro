---
// The site's home: what TracEconomics is, in plain words, the latest headline as a sentence, every
// topic and the countries. No chart, no tiles, no table: the numbers live on each topic's pages.
// Each place links to a page once. A planned topic is greyed out, with the reason, and is not a
// link.
import Base from "../../layouts/Base.astro";
import { BASE_AMOUNT, BASE_MONTH, headline } from "../../lib/headline";
import { eur } from "../../lib/income";
import { href, LANGS, month, t, type Lang } from "../../lib/i18n";
import { topic, topicHref, TOPICS } from "../../lib/topics";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const acc = (p: string) => month(lang, p, "acc");
const names = (codes: string[]) => codes.map((c) => t(lang, `country.${c}`)).join(", ");

// The headline comes from the first country of the first live topic.
const M1 = "inflation-by-group";
const country = topic(M1).countries[0];
const h = headline(country);
const SWATCH: Record<string, string> = { Q1: "var(--series-q1)", Q5: "var(--series-q5)" };
const countryName = t(lang, `country.${country}`);
const covered = [...new Set(TOPICS.filter((x) => x.status === "live").flatMap((x) => x.countries))];
---
<Base lang={lang} title={t(lang, "site.name")} description={t(lang, "site.tagline")} current="home">
  <div class="stack-lg">
    <section class="home-intro">
      <div class="stack" style="gap: var(--space-4)">
        <p class="eyebrow accent">{t(lang, "hub.eyebrow")}</p>
        <h1 class="home-title">{t(lang, "hub.title")}</h1>
        <p class="lead">{t(lang, "hub.intro1")}</p>
        <p class="lead-2">{t(lang, "hub.intro2")}</p>
      </div>
      <aside class="panel euros" aria-labelledby="euros-h">
        <p class="eyebrow">{t(lang, "hub.latest.eyebrow", { country: countryName })} · {t(lang, `topic.${M1}`)}</p>
        <p class="euros-lead" id="euros-h">{t(lang, "home.euros.lead", { amount: eur(BASE_AMOUNT), month: lang === "el" ? acc(BASE_MONTH) : month(lang, BASE_MONTH) })}</p>
        <dl class="euros-list">
          {h.baskets.map((b) => (
            <div>
              <dt>
                <svg width="16" height="8" viewBox="0 0 16 8" aria-hidden="true"><line x1="1" y1="4" x2="15" y2="4" stroke={SWATCH[b.group]} stroke-width="3" stroke-linecap="round"></line></svg>
                {t(lang, "home.euros.for", { group: t(lang, `group.in.${b.group}`) })}
              </dt>
              <dd>{eur(b.cost, 1)}</dd>
            </div>
          ))}
        </dl>
        <p class="small muted">{t(lang, "home.euros.note", { month: month(lang, h.latestMonth) })}</p>
        <a href={topicHref(lang, M1, country)} style="font-weight: 600">{t(lang, "hub.latest.link", { country: countryName })} →</a>
      </aside>
    </section>

    <section class="stack" aria-labelledby="topics-h" style="gap: var(--space-3)">
      <div class="section-head">
        <h2 id="topics-h">{t(lang, "hub.topics")}</h2>
        <p class="muted">{t(lang, "hub.topics.lead")}</p>
      </div>
      <div class="cards">
        {TOPICS.map((tp) => tp.status === "live" ? (
          <a class="card" href={topicHref(lang, tp.slug)}>
            <span class="chip-status">{t(lang, "hub.status.live", { list: names(tp.countries) })}</span>
            <span class="title">{t(lang, `topic.${tp.slug}`)} →</span>
            <span class="text">{t(lang, `topic.${tp.slug}.text`)}</span>
          </a>
        ) : (
          <div class="card planned">
            <span class="chip-status">{t(lang, "soon")}</span>
            <span class="title">{t(lang, `topic.${tp.slug}`)}</span>
            <span class="text">{t(lang, `topic.${tp.slug}.text`)}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="panel countries-strip" aria-labelledby="countries-h">
      <h2 id="countries-h">{t(lang, "hub.countries")}</h2>
      {covered.map((c) => <span class="country-chip">{t(lang, `country.${c}`)}</span>)}
      <span class="country-chip planned">{t(lang, "country.more")}</span>
      <p class="small muted">{t(lang, "hub.countries.text")}</p>
    </section>

    <section class="stack" style="gap: var(--space-2); border-top: 1px solid var(--color-border); padding-top: var(--space-5)">
      <h2 style="font-family: var(--font-sans); font-size: var(--text-base); font-weight: 700">{t(lang, "home.open.title")}</h2>
      <p class="muted" style="max-width: var(--text-max)">{t(lang, "opendata.lead")}</p>
      <a href={href(lang, "data")} style="font-weight: 600">{t(lang, "opendata.title")} →</a>
    </section>
  </div>
</Base>
