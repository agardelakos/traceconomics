---
// The site's home: what the site is for, in one line across the page; beneath it, what TracEconomics
// is, in plain words, beside one example from a live topic, linked to its full figures;
// then every topic (as the question it answers, under its short name), each leading to its page
// across countries; then the countries. No chart, no tiles, no table: the numbers live on each
// topic's pages. Planned countries and topics follow the cards' rule (MoreCard.astro).
import Base from "../../layouts/Base.astro";
import { BASE_AMOUNT, BASE_MONTH, bandLine, headline } from "../../lib/headline";
import { eur } from "../../lib/income";
import { LANGS, href, month, t, type Lang } from "../../lib/i18n";
import CountryCards from "../../components/CountryCards.astro";
import TopicCards from "../../components/TopicCards.astro";
import { topicHref, countryHref, topic } from "../../lib/topics";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const acc = (p: string) => month(lang, p, "acc");

// The headline comes from the first country of the first live topic.
const M1 = "inflation-by-group";
const country = topic(M1).countries[0];
const h = headline(country);
const SWATCH: Record<string, string> = { Q1: "var(--series-q1)", Q5: "var(--series-q5)" };
const countryName = t(lang, `country.${country}`);
// The title's phrases (one per line in its text), each with what it means here. The example card
// says "group", not "fifth": the home page has not explained income fifths yet.
const phrases = t(lang, "hub.title").split("\n");
const promises = phrases.map((phrase, i) => ({
  name: phrase,
  text: t(lang, `hub.promise.${["data", "questions", "answers"][i]}`),
}));
---
<Base lang={lang} title={t(lang, "site.name")} description={t(lang, "site.tagline")} current="home">
  <section slot="band" class="home-band">
    <svg class="band-line" viewBox="0 0 330 112" preserveAspectRatio="none" aria-hidden="true"><polyline points={bandLine(country)} /></svg>
    <div class="container">
      {/* One line where it fits, the phrases (one per line in the text) joined by teal dots; it breaks
          only between phrases, a dot ending the line, never starting one. Screen readers hear a full
          stop instead of the dot. On phones, one phrase per line and no dots. */}
      <h1 class="home-title">{phrases.map((s, i) => <>{i > 0 && " "}<span>{s}{i < phrases.length - 1 && <><span class="visually-hidden">.</span><span class="sep" aria-hidden="true">·</span></>}</span></>)}</h1>
    </div>
  </section>
  <div class="stack-lg">
    <div class="home-intro">
      <dl class="promises">
        {promises.map((p) => (
          <div>
            <dt>{p.name}</dt>
            <dd>{p.text}</dd>
          </div>
        ))}
      </dl>
      <aside class="panel euros" aria-labelledby="euros-h">
        <p class="eyebrow">{t(lang, "hub.fact.eyebrow", { topic: t(lang, `topic.${M1}`), country: countryName })}</p>
        <p class="euros-lead" id="euros-h">{t(lang, "home.euros.lead", { amount: eur(BASE_AMOUNT), month: lang === "el" ? acc(BASE_MONTH) : month(lang, BASE_MONTH) })}</p>
        <dl class="euros-list">
          {h.baskets.map((b) => (
            <div>
              <dt>
                <svg width="16" height="8" viewBox="0 0 16 8" aria-hidden="true"><line x1="1" y1="4" x2="15" y2="4" stroke={SWATCH[b.group]} stroke-width="3" stroke-linecap="round"></line></svg>
                {t(lang, `hub.fact.group.${b.group}`)}
              </dt>
              <dd>{eur(b.cost, 1)}</dd>
            </div>
          ))}
        </dl>
        <a href={countryHref(lang, country)} style="font-weight: 600">{t(lang, "hub.fact.link")} →</a>
      </aside>
    </div>

    <section class="stack" aria-labelledby="topics-h" style="gap: var(--space-3)">
      <h2 id="topics-h">{t(lang, "hub.topics.start")}</h2>
      <TopicCards lang={lang} link={(tp) => (tp.status === "live" ? topicHref(lang, tp.slug) : null)} />
    </section>

    <nav class="stack" aria-labelledby="countries-h" style="gap: var(--space-3)">
      <h2 id="countries-h">{t(lang, "hub.countries.title")}</h2>
      <CountryCards lang={lang} />
    </nav>

    <section class="stack" style="gap: var(--space-2); border-top: 1px solid var(--color-border); padding-top: var(--space-5)">
      <h2 style="font-family: var(--font-sans); font-size: var(--text-base); font-weight: 700">{t(lang, "home.open.title")}</h2>
      <p class="muted" style="max-width: var(--text-max)">{t(lang, "opendata.lead")}</p>
      <a href={href(lang, "data")} style="font-weight: 600">{t(lang, "opendata.title")} →</a>
    </section>
  </div>
</Base>
