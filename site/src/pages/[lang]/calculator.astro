---
// The personal calculator. Everything runs in the browser from the published calculator file;
// nothing a visitor enters leaves the device. Untouched, it shows a preset group's official
// series exactly (the parity test checks that).
import GlossaryTerm from "../../components/GlossaryTerm.astro";
import Base from "../../layouts/Base.astro";
import { calculator, labels, LATEST } from "../../lib/data";
import { href, LANGS, LOCALE, t, type Lang } from "../../lib/i18n";
import el from "../../i18n/el.json";
import en from "../../i18n/en.json";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const calc = calculator();
const names = labels().labels;
const divisions = Object.fromEntries(Object.entries(names).filter(([c]) => c.length === 2).map(([c, l]) => [c, l[lang]]));
const PRESETS = ["all/all", "B/Q1", "B/Q2", "B/Q3", "B/Q4", "B/Q5", "tenure/renter", "tenure/owner", "tenure/rent_free", "pensioners/pensioners", "pensioners/other"];
const presetName = (k: string) => t(lang, `group.${k.startsWith("B/") ? k.slice(2) : k}`);
for (const p of PRESETS) if (!calc.presets[p]) throw new Error(`calculator file lacks preset ${p}`);
const config = {
  lang, locale: LOCALE[lang], src: `/data/v1/${LATEST}/calculator.json`,
  presets: PRESETS.map((k) => ({ key: k, name: presetName(k) })),
  divisions, strings: lang === "el" ? el : en,
};
---
<Base lang={lang} title={t(lang, "calc.title")} description={t(lang, "calc.lead")} path="calculator" current="calculator">
  <div class="stack-lg" id="calculator" data-config={JSON.stringify(config)} style="max-width: 760px">
    <div class="stack" style="gap: var(--space-2)">
      <nav class="breadcrumb" aria-label={t(lang, "breadcrumb")}><a href={href(lang)}>{t(lang, "nav.home")}</a> / {t(lang, "nav.calculator")}</nav>
      <h1>{t(lang, "calc.title")}</h1>
      <p class="muted">{t(lang, "calc.lead")}</p>
    </div>

    <div class="callout">
      <svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true"><rect x="3" y="7" width="10" height="7" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4"></rect><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
      <span>{t(lang, "calc.private")}</span>
    </div>

    <label class="stack" style="gap: 6px; font-weight: 600">{t(lang, "calc.preset")}
      <select data-role="preset">
        {config.presets.map((p) => <option value={p.key} selected={p.key === "B/Q1"}>{p.name}</option>)}
      </select>
    </label>

    <div data-role="loading" class="stack" aria-busy="true">
      <div class="skeleton" style="height: 160px"></div>
      <span class="small muted">{t(lang, "calc.loading")}</span>
    </div>

    <section class="result" data-role="result" aria-live="polite" hidden>
      <span class="small muted" data-role="yours-label"></span>
      <span class="big" data-role="yours"></span>
      <span class="flag first-estimate" data-role="same" style="align-self: flex-start; border-color: var(--color-accent); color: var(--color-text)"></span>
      <span data-role="diff" hidden></span>
      <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); border-top: 1px solid var(--color-border); padding-top: var(--space-3)">
        <div class="stack" style="gap: 0"><span class="small muted" data-role="preset-name"></span><span class="num" style="font-size: 1.25rem; font-weight: 600" data-role="preset-rate"></span></div>
        <div class="stack" style="gap: 0"><span class="small muted">{t(lang, "group.all/all")}</span><span class="num" style="font-size: 1.25rem; font-weight: 600" data-role="all-rate"></span></div>
      </div>
      <button type="button" class="button" data-role="reset" hidden style="align-self: flex-start; border-color: var(--color-accent); color: var(--color-accent)"></button>
    </section>

    <figure class="chart panel" data-role="over-time" hidden>
      <figcaption><h2 style="font-family: var(--font-sans); font-size: var(--text-base); font-weight: 700">{t(lang, "calc.over_time")}</h2></figcaption>
      <div class="chart-area" role="img" data-role="chart"></div>
    </figure>

    <section class="stack" style="gap: 0" data-role="sliders-box" hidden>
      <div style="display: flex; justify-content: space-between; align-items: baseline">
        <h2>{t(lang, "calc.where")}</h2>
        <span class="small"><GlossaryTerm lang={lang} term="weights" /></span>
        <span class="small muted num">{t(lang, "calc.total")}</span>
      </div>
      <div class="callout caution" data-role="rescaled" hidden style="margin: var(--space-2) 0">
        <span>{t(lang, "calc.rescaled")}</span>
      </div>
      <div data-role="sliders"></div>
    </section>

    <section class="stack" style="gap: var(--space-2)">
      <h2>{t(lang, "calc.how.title")}</h2>
      <p>{t(lang, "calc.how.text", { from: calc.first_year })}</p>
      <a href={href(lang, "method")} style="font-weight: 600">{t(lang, "nav.method")} →</a>
    </section>
  </div>
</Base>

<script>
  import { start } from "../../scripts/calculator";
  const root = document.getElementById("calculator");
  if (root) start(root);
</script>
