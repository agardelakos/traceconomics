---
// Start here: a plain explainer for a first-time reader (src/content/pages/<lang>/start.md),
// followed by the poorest and richest fifth's baskets from the newest weights, so the page's main
// point is shown with real numbers.
import { getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { calculator, labels } from "../../lib/data";
import { href, LANGS, num, t, type Lang } from "../../lib/i18n";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const entry = await getEntry("pages", `${lang}/start`);
if (!entry) throw new Error(`no start page for ${lang}`);
const { Content } = await render(entry);

// Each group's spending split into the divisions that differ most between rich and poor, and the
// rest, from the calculator's newest weights (the same weights the series use).
const calc = calculator();
const names = labels().labels;
const PARTS = [
  { code: "01", color: "var(--series-q3)" },
  { code: "04", color: "var(--series-q4)" },
  { code: "07", color: "var(--series-q2)" },
];
const basket = (preset: string) => {
  const years = Object.keys(calc.presets[preset]).sort();
  const year = years[years.length - 1];
  const rows: [number, number][] = calc.presets[preset][year];
  const total = rows.reduce((a, [, w]) => a + w, 0);
  const share = (code: string) => (100 * rows.filter(([i]) => calc.codes[i].startsWith(code)).reduce((a, [, w]) => a + w, 0)) / total;
  const parts = PARTS.map((p) => ({ label: names[p.code][lang], color: p.color, value: share(p.code) }));
  const rest = 100 - parts.reduce((a, p) => a + p.value, 0);
  return { year, parts: [...parts, { label: t(lang, "start.baskets.rest"), color: "var(--color-disabled)", value: rest }] };
};
const groups = ["B/Q1", "B/Q5"].map((g) => ({ name: t(lang, `group.${g.slice(2)}`), ...basket(g) }));
if (groups[0].year !== groups[1].year) throw new Error("the two baskets come from different years");
---
<Base lang={lang} title={entry.data.title} description={entry.data.summary} path="start" current="start">
  <article class="stack-lg">
    <header class="stack" style="gap: var(--space-2); max-width: var(--text-max)">
      <nav class="breadcrumb" aria-label={t(lang, "breadcrumb")}><a href={href(lang)}>{t(lang, "nav.home")}</a> / {t(lang, "nav.start")}</nav>
      <h1>{entry.data.title}</h1>
      <p style="font-size: var(--text-lg)">{entry.data.summary}</p>
    </header>
    <section class="prose"><Content /></section>

    <section class="panel stack" aria-labelledby="baskets-h" style="gap: var(--space-4); max-width: var(--text-max)">
      <div class="stack" style="gap: var(--space-1)">
        <h2 id="baskets-h">{t(lang, "start.baskets.title")}</h2>
        <p class="muted">{t(lang, "start.baskets.lead", { year: groups[0].year })}</p>
      </div>
      {groups.map((g) => (
        <div class="stack" style="gap: var(--space-2)">
          <h3>{g.name}</h3>
          <div class="basket-bar" aria-hidden="true">
            {g.parts.map((p) => <span style={`width: ${p.value.toFixed(2)}%; background: ${p.color}`}></span>)}
          </div>
          <ul class="basket-legend">
            {g.parts.map((p) => (
              <li><span class="box" style={`background: ${p.color}`}></span>{p.label}: <strong>{num(lang, p.value, 0)}%</strong></li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="callout stack" style="gap: var(--space-3); max-width: var(--text-max); padding: var(--space-5)">
      <h2>{t(lang, "start.ready")}</h2>
      <div class="button-row">
        <a class="button primary" href={href(lang, "explore")}>{t(lang, "home.cta.explore")}</a>
        <a class="button" href={href(lang, "calculator")}>{t(lang, "start.cta.calculator")}</a>
      </div>
    </section>
  </article>
</Base>
