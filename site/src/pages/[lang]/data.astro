---
// Data and downloads: what the files are, every setting's files with their sizes, checksums,
// how to cite, the licence and the attribution.
import fs from "node:fs";
import path from "node:path";
import { getEntry, render } from "astro:content";
import SourceList from "../../components/SourceList.astro";
import Base from "../../layouts/Base.astro";
import { DATA_ROOT, LATEST, settings } from "../../lib/data";
import { href, LANGS, num, t, type Lang } from "../../lib/i18n";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const entry = await getEntry("pages", `${lang}/data`);
if (!entry) throw new Error(`no data page for ${lang}`);
const { Content } = await render(entry);
const base = `/data/v1/${LATEST}`;
const size = (bytes: number) => (bytes > 1e6 ? `${num(lang, bytes / 1e6)} MB` : `${num(lang, bytes / 1e3, 0)} KB`);
const stat = (rel: string) => fs.statSync(path.join(DATA_ROOT, LATEST, rel)).size;
const keys = ["spending", "imputed_rent", "price_source", "weights_timing", "tutoring"];
const rows = settings().settings.map((s) => {
  const dir = path.join(DATA_ROOT, LATEST, "downloads", s.slug);
  const files = fs.existsSync(dir) ? fs.readdirSync(dir).sort() : [];
  if (!files.length) throw new Error(`no downloads for ${s.slug}: run the full export`);
  return {
    slug: s.slug, isDefault: s.default,
    label: keys.map((k) => t(lang, `option.${k}.${s[k]}`)).join(" · "),
    files: files.map((f) => ({ name: f, href: `${base}/downloads/${s.slug}/${f}`, size: size(fs.statSync(path.join(dir, f)).size) })),
  };
});
const shared = ["SHA256SUMS", "availability.json", "metadata.json", "settings.json"].map((f) => ({ name: f, href: `${base}/${f}`, size: size(stat(f)) }));
---
<Base lang={lang} title={entry.data.title} description={entry.data.summary} path="data" current="data">
  <article class="stack-lg">
    <header class="stack" style="gap: var(--space-2); max-width: var(--text-max)">
      <nav class="breadcrumb" aria-label={t(lang, "breadcrumb")}><a href={href(lang)}>{t(lang, "nav.home")}</a> / {t(lang, "nav.data")}</nav>
      <h1>{entry.data.title}</h1>
      <p style="font-size: var(--text-lg)">{entry.data.summary}</p>
    </header>
    <section class="prose"><Content /></section>

    <section class="stack" style="gap: var(--space-3)">
      <h2>{t(lang, "explore.downloads")}</h2>
      <div class="downloads">
        {shared.map((f) => (
          <div class="row"><a href={f.href} download>{f.name}</a><span class="small muted num">{f.size}</span></div>
        ))}
      </div>
      {rows.map((r) => (
        <details class="panel" open={r.isDefault}>
          <summary>{r.label}{r.isDefault && <> <span class="badge-default">{t(lang, "option.default")}</span></>}</summary>
          <div class="downloads" style="margin-top: var(--space-3)">
            {r.files.map((f) => (
              <div class="row"><a href={f.href} download>{f.name}</a><span class="small muted num">{f.size}</span></div>
            ))}
          </div>
        </details>
      ))}
    </section>

    <section class="stack" style="gap: var(--space-2)">
      <h2>{t(lang, "method.sources")}</h2>
      <SourceList keys={entry.data.sources} lang={lang} />
    </section>
  </article>
</Base>
