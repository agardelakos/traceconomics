---
// Every page: language, title, description, fonts (served from this site; no outside requests),
// the design tokens, header and footer. A country's pages (its own page passes `country`, its
// topics' pages `topic` with a country) get the country bar under the header, the same on each, and
// the header's country switch leads to the same page for another country. A topic's page across
// countries gets the topic bar. The language switch leads to the same address. Release builds add
// the visit-count beacon, the one outside request (lib/analytics.ts).
import "@fontsource/source-sans-3/400.css";
import "@fontsource/source-sans-3/600.css";
import "@fontsource/source-sans-3/700.css";
import "@fontsource/source-serif-4/600.css";
import "@fontsource/source-code-pro/400.css";
import "../styles/tokens.css";
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import CountryBar from "../components/CountryBar.astro";
import TopicBar from "../components/TopicBar.astro";
import { href, isOffered, otherLang, t, type Lang } from "../lib/i18n";
import { countryHref, topic as topicOf, topicHref, topicPath } from "../lib/topics";
import { analyticsOn, BEACON, TOKEN } from "../lib/analytics";

interface Props {
  lang: Lang; title: string; description: string; path?: string; current?: string; country?: string;
  topic?: { slug: string; country?: string; section?: string };
}
const { lang, title, description, topic } = Astro.props;
const path = topic ? topicPath(topic.slug, topic.country, topic.section) : (Astro.props.path ?? "");
const current = topic ? topic.slug : Astro.props.current;
const country = topic?.country ?? Astro.props.country;
// Another country's version of this page, where it has the topic; its own page otherwise.
const countryLink = topic?.country === undefined ? undefined : (c: string) =>
  topicOf(topic.slug).countries.includes(c) ? topicHref(lang, topic.slug, c, topic.section?.split("/")[0]) : countryHref(lang, c);
const full = title === t(lang, "site.name") ? title : `${title} · ${t(lang, "site.name")}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{full}</title>
    {isOffered(otherLang(lang)) && <link rel="alternate" hreflang={otherLang(lang)} href={href(otherLang(lang), path)} />}
    <link rel="alternate" hreflang={lang} href={href(lang, path)} />
    <script is:inline src="/theme.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#content">{t(lang, "skip")}</a>
    <SiteHeader lang={lang} path={path} current={current} country={country} countryLink={countryLink} />
    {country !== undefined && <CountryBar lang={lang} country={country} slug={topic?.slug} section={topic?.section} />}
    {topic && topic.country === undefined && <TopicBar lang={lang} slug={topic.slug} />}
    <main id="content">
      <div class="container">
        <slot />
      </div>
    </main>
    <SiteFooter lang={lang} />
    {analyticsOn() && <script is:inline type="module" src={BEACON} data-cf-beacon={JSON.stringify({ token: TOKEN })}></script>}
  </body>
</html>

<script>
  import { start } from "../scripts/terms";
  start();
</script>
