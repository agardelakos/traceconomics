---
// Every page: language, title, description, fonts (served from this site; no outside requests),
// the design tokens, header and footer.
import "@fontsource/source-sans-3/400.css";
import "@fontsource/source-sans-3/600.css";
import "@fontsource/source-sans-3/700.css";
import "@fontsource/source-serif-4/600.css";
import "@fontsource/source-code-pro/400.css";
import "../styles/tokens.css";
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { href, otherLang, t, type Lang } from "../lib/i18n";

interface Props { lang: Lang; title: string; description: string; path?: string; current?: string }
const { lang, title, description, path = "", current } = Astro.props;
const full = title === t(lang, "site.name") ? title : `${title} · ${t(lang, "site.name")}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{full}</title>
    <link rel="alternate" hreflang={otherLang(lang)} href={href(otherLang(lang), path)} />
    <link rel="alternate" hreflang={lang} href={href(lang, path)} />
  </head>
  <body>
    <a class="skip-link" href="#content">{t(lang, "skip")}</a>
    <SiteHeader lang={lang} path={path} current={current} />
    <main id="content">
      <div class="container">
        <slot />
      </div>
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>
