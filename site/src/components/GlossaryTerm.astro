---
// A glossary term inside running text: pressing it opens the term's one-sentence explanation
// with a link to its page. Uses the browser's own popover (no script; Escape or a click outside
// closes it). A browser without popovers shows the explanation in place.
import { getEntry } from "astro:content";
import { href, t, type Lang } from "../lib/i18n";

interface Props { lang: Lang; term: string; label?: string }
const { lang, term, label } = Astro.props;
const entry = await getEntry("glossary", `${lang}/${term}`);
if (!entry) throw new Error(`no glossary term "${term}" in ${lang}`);
// Deterministic, so builds are reproducible: the term plus a short code of its label.
const text = label ?? entry.data.term;
let h = 0;
for (const ch of text) h = (h * 31 + ch.codePointAt(0)!) >>> 0;
const id = `term-${term}-${h.toString(36)}`;
---
<span class="term-wrap"><button type="button" class="term" popovertarget={id} style={`anchor-name: --${id}`}>{text}</button><span popover id={id} class="term-popover" role="note" style={`position-anchor: --${id}`}>
  <strong>{entry.data.term}</strong>
  <span>{entry.data.short}</span>
  <a href={href(lang, `glossary/${term}`)}>{t(lang, "glossary.more")}</a>
</span></span>
