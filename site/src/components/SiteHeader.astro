---
// The header on every page: wordmark, the language switch (always in view: a reader who lands
// on the wrong language must find it at once), the settings button (the colour theme today, other
// reader preferences later) and the main navigation, all alike: home, the country switch, then the
// pages for the whole site. Most readers come for one country, so the country is the first choice; topics
// are listed on each country's page and on the home page, not here, so the header stays one line
// however many topics the site grows.
//
// The country switch is a popover, so it opens without a script. Each country leads to the page
// the reader is on, for that country, where it has one, and to the country's page otherwise. A
// country not built yet is listed greyed out, marked "coming soon", and is not a link.
//
// On a phone the navigation and the settings fold into one menu button. The menu is a popover,
// so it opens without a script; on wider screens the same element is shown in the page as a row.
// The theme controls need a script, so they stay hidden until it runs (scripts/theme.ts).
import { href, isOffered, t, type Lang } from "../lib/i18n";
import { flag } from "../lib/flags";
import { countries, countryHref } from "../lib/topics";

interface Props { lang: Lang; path: string; current?: string; country?: string; countryLink?: (c: string) => string }
const { lang, path, current, country } = Astro.props;
const countryLink = Astro.props.countryLink ?? ((c: string) => countryHref(lang, c));
const site = ["glossary", "data", "about"].map((key) => ({ key, link: href(lang, key), label: t(lang, `nav.${key}`) }));
// A language not offered yet is shown greyed and is not a link (on its own pages it stays marked as current).
const SWITCH: { code: Lang; label: string }[] = [{ code: "el", label: "ΕΛ" }, { code: "en", label: "EN" }];
const check = '<path d="M3 7.5 L6 10 L11 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>';
---
<header class="site-header">
  <div class="container bar">
    <a class="wordmark" href={href(lang)}>
      <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">
        <rect x="1" y="1" width="26" height="26" rx="6" fill="none" stroke="var(--color-accent)" stroke-width="2"></rect>
        <path d="M6 19 L11 13 L15 16 L22 8" fill="none" stroke="var(--color-accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <span>{t(lang, "site.name")}</span>
    </a>
    <div class="header-tools">
      <div class="lang-switch" role="group" aria-label={t(lang, "lang.switch")}>
        {SWITCH.map((l) => isOffered(l.code) || l.code === lang
          ? <a href={href(l.code, path)} lang={l.code} aria-current={lang === l.code ? "true" : undefined}>{l.label}</a>
          : <span class="unpublished" lang={l.code} aria-disabled="true">{l.label}</span>)}
      </div>
      <div class="settings" data-role="theme" hidden>
        <button type="button" class="icon-button" popovertarget="settings-menu" style="anchor-name: --settings-menu" aria-label={t(lang, "settings.label")} title={t(lang, "settings.label")}>
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
            <path d="M2 5h8M14 5h2M2 13h2M8 13h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
            <circle cx="12" cy="5" r="2" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
            <circle cx="6" cy="13" r="2" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
          </svg>
        </button>
        <div popover id="settings-menu" class="theme-menu" style="position-anchor: --settings-menu">
          <fieldset>
            <legend>{t(lang, "theme.label")}</legend>
            {["system", "light", "dark"].map((v) => (
              <label><input type="radio" name="theme" value={v} /> {t(lang, `theme.${v}`)}</label>
            ))}
          </fieldset>
          <p class="small muted">{t(lang, "theme.stored")}</p>
        </div>
      </div>
      <button type="button" class="icon-button menu-button" popovertarget="site-menu" aria-label={t(lang, "nav.menu")} title={t(lang, "nav.menu")}>
        <svg width="20" height="20" viewBox="0 0 18 18" aria-hidden="true"><path d="M3 5h12M3 9h12M3 13h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
      </button>
    </div>
  </div>
  <nav popover id="site-menu" class="site-nav" aria-label={t(lang, "nav.label")}>
    <ul class="container">
      <li><a href={href(lang)} aria-current={current === "home" ? "page" : undefined}>{t(lang, "nav.home")}</a></li>
      <li>
        <button type="button" class="nav-country" popovertarget="country-menu" style="anchor-name: --country-menu" aria-haspopup="true"
          aria-label={country ? `${t(lang, "country.switch")}: ${t(lang, `country.${country}`)}` : t(lang, "country.choose")}>
          {country ? t(lang, `country.${country}`) : t(lang, "nav.countries")}
          <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 L6 8 L9.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
        <div popover id="country-menu" class="country-menu" style="position-anchor: --country-menu">
          <ul>
            {countries().map((c) => (
              <li>
                <a href={countryLink(c)} aria-current={c === country ? "true" : undefined}>
                  <span class="country-name"><Fragment set:html={flag(c)} />{t(lang, `country.${c}`)}</span>
                  {c === country && <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" set:html={check}></svg>}
                </a>
              </li>
            ))}
            <li><span class="planned">{t(lang, "country.more")} <span class="planned-tag">{t(lang, "soon")}</span></span></li>
          </ul>
        </div>
      </li>
      {site.map((i) => (
        <li><a href={i.link} aria-current={current === i.key ? "page" : undefined}>{i.label}</a></li>
      ))}
    </ul>
    <div class="menu-settings container" data-role="theme" hidden>
      <fieldset>
        <legend>{t(lang, "theme.label")}</legend>
        {["system", "light", "dark"].map((v) => (
          <label><input type="radio" name="theme-menu" value={v} /> {t(lang, `theme.${v}`)}</label>
        ))}
      </fieldset>
      <p class="small muted">{t(lang, "theme.stored")}</p>
    </div>
  </nav>
</header>

<script>
  import { start } from "../scripts/theme";
  start([...document.querySelectorAll<HTMLElement>('[data-role="theme"]')]);
</script>
