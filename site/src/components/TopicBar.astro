---
// Under the header on a topic's page across countries: the topic's name. A country's pages have
// their own bar (CountryBar.astro); this page lists the countries itself.
import { t, type Lang } from "../lib/i18n";
import { topicHref } from "../lib/topics";

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
---
<div class="topic-bar">
  <div class="container topic-stack">
    <div class="topic-title">
      <span class="eyebrow">{t(lang, "topic.eyebrow")}</span>
      <a class="topic-name" href={topicHref(lang, slug)} aria-current="page">{t(lang, `topic.${slug}.long`)}</a>
    </div>
  </div>
</div>
