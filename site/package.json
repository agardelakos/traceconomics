{
  "name": "traceconomics-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The TracEconomics website: static pages built from the published data files.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "check": "astro check && vitest run && astro build && node scripts/checks.mjs",
    "check:code": "astro check && vitest run --exclude src/lib/engine/parity.test.ts",
    "a11y": "node scripts/a11y.mjs",
    "shots": "node scripts/shots.mjs",
    "csp": "node scripts/csp.mjs"
  },
  "dependencies": {
    "@fontsource/source-code-pro": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "@observablehq/plot": "0.6.17",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-satteri": "0.4.2",
    "@axe-core/playwright": "4.13.0",
    "@types/node": "24.19.1",
    "js-yaml": "4.3.2",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "wrangler": "4.154.0"
  }
}
