{
  "name": "traceconomics-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The TracEconomics website: static pages built from the published data files.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:ui": "playwright test",
    "check": "astro check && vitest run && astro build && node scripts/checks.mjs",
    "check:code": "astro check && vitest run --exclude src/lib/engine/parity.test.ts --exclude src/lib/data-files.test.ts",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "@fontsource/source-code-pro": "5.3.1",
    "@fontsource/source-sans-3": "5.3.1",
    "@fontsource/source-serif-4": "5.3.1",
    "@observablehq/plot": "0.6.17",
    "astro": "7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-satteri": "0.4.4",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "js-yaml": "4.3.2",
    "monocart-coverage-reports": "3.0.0",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "vitest-monocart-coverage": "5.0.0",
    "wrangler": "4.154.0"
  }
}
